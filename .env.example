# OpenAI API Key
OPENAI_API_KEY=your_openai_key_here

# Google Gemini API Key
GOOGLE_API_KEY=your_google_api_key_here

# Pinecone Vector DB configuration
PINECONE_API_KEY=your_pinecone_key_here
PINECONE_ENV=us-east-1
PINECONE_INDEX_NAME=medgraph

# Cohere Reranking API Key
COHERE_API_KEY=your_cohere_key_here

# Neo4j Graph DB configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Redis Cache configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# LangSmith Tracing configuration (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=medgraph-ai

# AWS & SageMaker configuration (for Gemma 2 reasoning)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_ROLE_ARN=arn:aws:iam::your_aws_account_id:role/your_sagemaker_role

# SageMaker Endpoint name
SAGEMAKER_ENDPOINT_NAME=gemma-2-9b-medgraph-endpoint

# Hugging Face integration (for model loading/seeding/weights)
HF_MODEL_ID=your_hf_username/your_merged_model_name
HF_API_TOKEN=your_huggingface_read_token
